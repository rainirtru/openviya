<Window x:Class="OpenViya.Ops.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenViya Ops" Width="1280" Height="820" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Background="{StaticResource Canvas}"><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#131E27" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="20,22,16,16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="OPENVIYA" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Teal}"/><TextBlock Text="OPS" FontSize="28" FontWeight="SemiBold" Margin="0,1,0,23"/><Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,20"/><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><Border Background="#1B2B35" BorderBrush="#344653" BorderThickness="1" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="Инфраструктура" FontWeight="SemiBold"/><TextBlock x:Name="SidebarCount" Text="Загрузка реестра…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button x:Name="DnsSettingsButton" Content="Настройки Timeweb DNS…" Click="DnsSettings_Click"/><TextBlock Text="ЛОКАЛЬНЫЙ РЕЕСТР" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/><TextBlock Text="Данные хранятся на этом устройстве" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,12"/><Button Content="Импорт профилей…" Click="Import_Click"/><Button Content="Экспорт профилей…" Click="Export_Click" Margin="0,0,8,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="26,22,26,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="РЕЕСТР СЕРВЕРОВ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/><TextBlock Text="Узлы и доступ" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Добавить существующий" Click="New_Click"/><Button Content="Настроить новый VPS" Background="#26475C" BorderBrush="#477897" Margin="0" Click="ProvisionNew_Click"/></StackPanel></Grid>
   <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,14"><Grid Background="{StaticResource Canvas}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="SearchBox" Height="36" MinHeight="36" Padding="10,6,42,6" VerticalContentAlignment="Center" ToolTip="Поиск по имени, адресу, роли или региону" TextChanged="Search_Changed"/><Button x:Name="ClearSearchButton" Content="×" ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск" HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="30" MinHeight="30" Padding="0" Margin="0,0,4,0" Visibility="Collapsed" Click="ClearSearch_Click"/></Grid><TextBlock x:Name="PageLabel" Grid.Column="1" Text="Страница 1" Foreground="{StaticResource Muted}" Margin="16,0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="‹" Padding="12,5" MinHeight="32" Click="PrevPage_Click"/><Button Content="›" Padding="12,5" MinHeight="32" Margin="0" Click="NextPage_Click"/></StackPanel></Grid></Border>
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><DataGrid x:Name="ServerGrid" SelectionChanged="ServerGrid_SelectionChanged" Sorting="ServerGrid_Sorting" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ИМЯ" Binding="{Binding Name}" SortMemberPath="Name" Width="1.25*"/><DataGridTextColumn Header="АДРЕС" Binding="{Binding Host}" SortMemberPath="Host" Width="1.35*"/><DataGridTextColumn Header="РОЛЬ" Binding="{Binding RoleLabel}" SortMemberPath="RoleLabel" Width="0.8*"/><DataGridTextColumn Header="РЕГИОН · №" Binding="{Binding RegionNode}" SortMemberPath="RegionNode" Width="0.9*"/><DataGridTextColumn Header="SSH" Binding="{Binding SshEndpoint}" SortMemberPath="SshEndpoint" Width="0.9*"/></DataGrid.Columns></DataGrid><Border x:Name="EmptyState" Background="{StaticResource Surface}" Visibility="Collapsed" IsHitTestVisible="True"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"><TextBlock x:Name="EmptyTitle" Text="Реестр пуст" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyCopy" Text="Добавьте существующий VPS, чтобы сохранить его адрес и параметры доступа." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><Button Content="Добавить сервер" Click="New_Click" HorizontalAlignment="Center" IsHitTestVisible="True"/></StackPanel></Border></Grid>
    <Border x:Name="EditorPanel" Grid.Row="1" Visibility="Collapsed" Background="#192630" BorderBrush="{StaticResource Blue}" BorderThickness="1" Padding="18" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12"><TextBlock x:Name="EditorTitle" Text="Новый сервер" FontSize="18" FontWeight="SemiBold"/><Button Content="Закрыть" DockPanel.Dock="Right" Margin="0" Click="CancelEdit_Click"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="340"><Grid Margin="0,0,8,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,8"><Label Content="Имя сервера"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,8"><Label Content="IP или hostname"/><TextBox x:Name="HostBox"/></StackPanel><StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8"><Label Content="Роль"/><ComboBox x:Name="RoleBox" SelectionChanged="DefaultsChanged"><ComboBoxItem Content="VPN_NODE" Tag="VpnNode"/><ComboBoxItem Content="CONTROL" Tag="Control"/><ComboBoxItem Content="APP" Tag="App"/></ComboBox></StackPanel>
     <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,8"><Label Content="Режим поддоменов"/><ComboBox x:Name="SubdomainModeBox" SelectionChanged="SubdomainModeChanged"><ComboBoxItem Content="Автоматически" Tag="Automatic"/><ComboBoxItem Content="Вручную" Tag="Manual"/></ComboBox></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,8"><Label Content="DNS-зона"/><TextBox x:Name="DnsZoneBox" Text="openviya.online" TextChanged="DefaultsChanged"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8"><Label Content="DNS-адрес · пусто = IP узла"/><TextBox x:Name="DnsAddressBox"/></StackPanel>
     <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,8"><Label Content="Регион"/><TextBox x:Name="RegionBox" TextChanged="DefaultsChanged"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,14,8"><Label Content="Индекс ноды"/><TextBox x:Name="IndexBox" TextChanged="DefaultsChanged"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8"><Label Content="SSH-пользователь"/><TextBox x:Name="UserBox"/></StackPanel>
     <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,14,8"><Label Content="Файл SSH-ключа · путь на этом компьютере"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="KeyBox"/><Button Grid.Column="1" Content="Обзор…" Margin="8,0,0,0" Click="BrowseKey_Click"/></Grid></StackPanel><StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,8"><Label Content="SSH-порт"/><TextBox x:Name="SshPortBox"/></StackPanel>
     <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,14,8"><Label Content="Домен панели"/><TextBox x:Name="PanelBox" TextChanged="DefaultsChanged"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,14,8"><Label Content="Фактический порт панели"/><TextBox x:Name="PanelPortBox"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,8"><Label Content="VPN-домен"/><TextBox x:Name="VpnBox" TextChanged="DefaultsChanged"/></StackPanel>
     <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,14,8"><Label Content="Путь панели · хранится DPAPI"/><PasswordBox x:Name="BasePathBox" Background="{StaticResource Raised}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" Padding="10,8" MinHeight="38"/></StackPanel><StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,14,8"><Label Content="Локальный порт · пусто = подобрать"/><TextBox x:Name="LocalPortBox"/></StackPanel><StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,8"><Label Content="VPN-порт"/><TextBox x:Name="VpnPortBox"/></StackPanel>
     <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,14,8"><Label Content="Открывать панель через"/><ComboBox x:Name="PanelOpenModeBox" SelectionChanged="PanelOpenModeChanged"><ComboBoxItem Content="SSH-туннель" Tag="Tunnel"/><ComboBoxItem Content="Публичный HTTPS" Tag="PublicHttps"/></ComboBox></StackPanel><StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"><Label Content="Разрешённые IP для публичной панели · по одному адресу на строку"/><TextBox x:Name="PanelAllowedIpsBox" Height="72" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Список сохраняется в профиле и используется при настройке нового VPS или смене режима доступа." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
     <TextBlock x:Name="DnsModeHint" Grid.Row="7" Grid.ColumnSpan="3" Text="В автоматическом режиме имена пересчитываются при смене роли, региона, индекса и зоны. При сохранении профиль создаст DNS-записи, если сохранён токен Timeweb; чужие и конфликтующие записи не изменяются." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,4"/><TextBlock x:Name="FormError" Grid.Row="8" Grid.ColumnSpan="3" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </Grid></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="SaveProfileButton" Content="Сохранить профиль" Background="#26475C" BorderBrush="#477897" Click="SaveProfile_Click"/><Button Content="Отмена" Margin="0" Click="CancelEdit_Click"/></StackPanel></Grid></Border>
        <Border x:Name="DetailsPanel" Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,12" Margin="0,14,0,0" MaxHeight="278" Visibility="Collapsed">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False"><StackPanel><TextBlock x:Name="DetailTitle" Text="Сервер" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DetailMeta" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Изменить" Click="Edit_Click"/><Button Content="Удалить профиль" Foreground="{StaticResource Danger}" Margin="0" Click="Delete_Click"/></StackPanel></DockPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <StackPanel>
            <Border x:Name="ProvisionCard" Background="#14212A" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,7" Margin="0,0,0,6" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="ХОД НАСТРОЙКИ VPS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brass}"/><TextBlock x:Name="ProvisionStageText" Text="Запуск не найден." FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock x:Name="ProvisionMessageText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel><WrapPanel Grid.Column="1" MaxWidth="220" VerticalAlignment="Center"><Button x:Name="ViewProvisionLogButton" Content="Журнал настройки…" Click="ViewProvisionLog_Click"/><Button x:Name="ResumeProvisionButton" Content="Продолжить настройку…" Visibility="Collapsed" Click="ResumeProvision_Click"/><Button x:Name="ViewCredentialsButton" Content="Данные панели…" Visibility="Collapsed" Margin="0" Click="ViewCredentials_Click"/></WrapPanel></Grid></Border>
            <Border Background="#14212A" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,7" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock x:Name="DesiredPanelAccessText" Foreground="{StaticResource Teal}" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,4,0,0"><TextBlock x:Name="TunnelLabel" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,18,2"/><TextBlock x:Name="SshObservationText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,18,2"/><TextBlock x:Name="PanelObservationText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,18,2"/><TextBlock x:Name="CertificateObservationText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,2"/></WrapPanel>
                <TextBlock x:Name="ObservedCheckedAtText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <TabControl x:Name="ServerActionsTabs" MinHeight="94" MaxHeight="156" Margin="0,0,0,6">
              <TabItem Header="Доступ"><WrapPanel Margin="10,8,0,0"><Button x:Name="OpenPanelButton" Content="Открыть панель" Background="#23423F" BorderBrush="#41756E" Click="OpenPanel_Click"/><Button Content="Открыть SSH" Click="OpenTerminal_Click"/><Button x:Name="DiagnosticsButton" Content="Диагностика" Click="Diagnostics_Click"/></WrapPanel></TabItem>
              <TabItem Header="Проверки и туннель"><WrapPanel Margin="10,8,0,0"><Button x:Name="CheckSshButton" Content="Проверить SSH" Click="CheckSsh_Click"/><Button x:Name="StartTunnelButton" Content="Включить туннель" Click="StartTunnel_Click"/><Button x:Name="StopTunnelButton" Content="Остановить туннель" Click="StopTunnel_Click"/><Button Content="Сканировать SSH host key" Click="ScanKeys_Click"/><Button x:Name="CheckTlsButton" Content="Проверить TLS панели" Margin="0" Click="CheckTls_Click"/></WrapPanel></TabItem>
              <TabItem Header="Обслуживание"><WrapPanel Margin="10,8,0,0"><Button Content="Обслуживание VPS…" Click="OpenMaintenance_Click"/></WrapPanel></TabItem>
              <TabItem Header="DNS и hosts"><StackPanel Margin="10,8,10,6"><WrapPanel><Button Content="Проверить hosts" Click="InspectHosts_Click"/><Button Content="Применить hosts…" Click="ApplyHosts_Click"/><Button Content="Удалить свою hosts-запись…" Margin="0" Click="RemoveHosts_Click"/></WrapPanel><Border x:Name="DnsPlanCard" Background="#14212A" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,6" Margin="0,2,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="70"><StackPanel><TextBlock Text="ПЛАН DNS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Teal}"/><TextBlock x:Name="DnsPlanText" Text="План не запрашивался." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,8,0"/></StackPanel></ScrollViewer><WrapPanel Grid.Column="1" MaxWidth="300" VerticalAlignment="Center"><Button x:Name="BuildDnsPlanButton" Content="Проверить DNS" Click="BuildDnsPlan_Click"/><Button x:Name="ApplyDnsButton" Content="Применить план DNS" IsEnabled="False" Click="ApplyDnsPlan_Click"/><Button x:Name="PublicDnsButton" Content="Публичный DNS (Cloudflare)" ToolTip="Только чтение через Cloudflare DNS-over-HTTPS" Margin="0" Click="CheckPublicDns_Click"/></WrapPanel></Grid></Border></StackPanel></TabItem>
            </TabControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
   </Grid>
   <Border Grid.Row="3" Background="#192630" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="10,8" Margin="0,14,0,0"><DockPanel LastChildFill="False"><TextBlock x:Name="StatusText" Text="Подключение к локальному реестру…" Foreground="{StaticResource Muted}"/><TextBlock DockPanel.Dock="Right" Text="OPENVIYA OPS · ЛОКАЛЬНО" FontSize="10" Foreground="{StaticResource Muted}"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
