<Window x:Class="OpenViya.Ops.Desktop.VpsCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Данные панели" Width="700" Height="620" MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="ЛОКАЛЬНЫЕ ДАННЫЕ ДОСТУПА" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock Text="Учётная запись панели" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,4"/>
      <TextBlock x:Name="PanelAddressText" Text="HTTPS-панель" Foreground="{StaticResource Muted}"/>
      <TextBlock Text="Секреты хранятся локально в зашифрованном виде. Они показаны только в этом окне по вашему запросу; копирование выполняется отдельной кнопкой для каждого поля." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="Имя пользователя панели"/><PasswordBox x:Name="UserMasked" MinHeight="38" Padding="10,8"/><TextBox x:Name="UserRevealed" Visibility="Collapsed" IsReadOnly="True"/></StackPanel><Button Grid.Column="1" Content="Копировать" Tag="User" VerticalAlignment="Bottom" Click="Copy_Click"/></Grid>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="Пароль панели"/><PasswordBox x:Name="PasswordMasked" MinHeight="38" Padding="10,8"/><TextBox x:Name="PasswordRevealed" Visibility="Collapsed" IsReadOnly="True"/></StackPanel><Button Grid.Column="1" Content="Копировать" Tag="Password" VerticalAlignment="Bottom" Click="Copy_Click"/></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Label Content="Путь панели"/><PasswordBox x:Name="PathMasked" MinHeight="38" Padding="10,8"/><TextBox x:Name="PathRevealed" Visibility="Collapsed" IsReadOnly="True"/></StackPanel><Button Grid.Column="1" Content="Копировать" Tag="Path" VerticalAlignment="Bottom" Click="Copy_Click"/></Grid>
          </StackPanel>
        </Border>
        <CheckBox x:Name="RevealCheck" Foreground="{StaticResource Ink}" Checked="Reveal_Changed" Unchecked="Reveal_Changed"><TextBlock Foreground="{StaticResource Ink}" Text="Показать данные в этом окне" TextWrapping="Wrap"/></CheckBox>
        <TextBlock x:Name="CopyStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="2" Content="Готово" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="100" Margin="0,16,0,0" Click="Close_Click"/>
  </Grid>
</Window>
