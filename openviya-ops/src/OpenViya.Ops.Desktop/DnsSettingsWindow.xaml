<Window x:Class="OpenViya.Ops.Desktop.DnsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timeweb DNS · настройки" Width="620" Height="640" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="НАСТРОЙКИ DNS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Teal}"/>
      <TextBlock Text="Timeweb API" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/>
      <TextBlock Text="Токен хранится локально, зашифрованный DPAPI для текущего пользователя Windows. Проверка зоны выполняет только чтение." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="API-токен" FontWeight="SemiBold"/>
            <TextBlock x:Name="TokenState" Text="Проверяем локальное хранилище…" Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
            <PasswordBox x:Name="TokenBox" Background="{StaticResource Raised}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}" Padding="10,8" MinHeight="38" ToolTip="Вставьте токен Timeweb для замены. Поле очищается после сохранения."/>
            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="SaveTokenButton" Content="Зашифровать и сохранить" Click="SaveToken_Click"/>
              <Button x:Name="ClearTokenButton" Content="Удалить токен" Foreground="{StaticResource Danger}" Margin="0" Click="ClearToken_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16">
          <StackPanel>
            <TextBlock Text="Проверка доступа к DNS-зоне" FontWeight="SemiBold"/>
            <TextBlock Text="Проверка не создаёт, не редактирует и не удаляет записи." Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="ZoneBox" Text="openviya.online" VerticalContentAlignment="Center" ToolTip="DNS-зона для read-only проверки"/>
              <Button x:Name="CheckZoneButton" Grid.Column="1" Content="Проверить зону" Margin="8,0,0,0" Click="CheckZone_Click"/>
            </Grid>
            <TextBlock x:Name="ZoneResult" Text="Проверка не запускалась." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Токен не отображается и не включается в сообщения об ошибке." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
      <Button Grid.Column="1" Content="Готово" IsDefault="True" IsCancel="True" Margin="0" Click="Close_Click"/>
    </Grid>
  </Grid>
</Window>
