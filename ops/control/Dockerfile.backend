ARG JAVA_RUNTIME_IMAGE=eclipse-temurin:25-jre
FROM ${JAVA_RUNTIME_IMAGE}
WORKDIR /app
COPY panel-ca.crt /usr/local/share/ca-certificates/openviya-panel.crt
RUN keytool -importcert -noprompt -alias openviya-panel-ca -file /usr/local/share/ca-certificates/openviya-panel.crt -cacerts -storepass changeit
RUN groupadd --system app && useradd --system --gid app app
COPY app.jar /app/app.jar
USER app
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
