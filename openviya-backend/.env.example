# Copy to .env for local use. Replace the local-only password before deployment.
OPENVIYA_DB_NAME=openviya
OPENVIYA_DB_USERNAME=openviya
OPENVIYA_DB_PASSWORD=change-this-local-password
OPENVIYA_DB_URL=jdbc:postgresql://db:5432/openviya
OPENVIYA_DB_POOL_SIZE=10
SERVER_PORT=8080
OPENVIYA_PUBLIC_BASE_URL=http://localhost:8080
# Set false only for local HTTP development. Production must use HTTPS and true.
OPENVIYA_SESSION_COOKIE_SECURE=false
OPENVIYA_SESSION_TIMEOUT=30m
# Generate a random 32-byte key and encode it as Base64 before enabling staff 2FA.
OPENVIYA_TOTP_ENCRYPTION_KEY=
OPENVIYA_TOTP_ENCRYPTION_KEY_VERSION=v1
OPENVIYA_AUTH_CHALLENGE_LIFETIME=5m
# One-time bootstrap only. Remove/disable after the first startup.
OPENVIYA_BOOTSTRAP_OWNER_ENABLED=false
OPENVIYA_BOOTSTRAP_OWNER_LOGIN=
OPENVIYA_BOOTSTRAP_OWNER_PASSWORD=
OPENVIYA_QUEUE_POLL_INTERVAL=1s
OPENVIYA_QUEUE_BATCH_SIZE=20
OPENVIYA_QUEUE_LEASE_DURATION=30s
