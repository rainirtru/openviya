# Copy to .env for local use. Replace the local-only password before deployment.
OPENVIYA_DB_NAME=openviya
OPENVIYA_DB_USERNAME=openviya
OPENVIYA_DB_PASSWORD=change-this-local-password
OPENVIYA_DB_URL=jdbc:postgresql://db:5432/openviya
OPENVIYA_DB_POOL_SIZE=10
SERVER_PORT=8080
OPENVIYA_PUBLIC_BASE_URL=http://localhost:8080
OPENVIYA_QUEUE_POLL_INTERVAL=1s
OPENVIYA_QUEUE_BATCH_SIZE=20
OPENVIYA_QUEUE_LEASE_DURATION=30s
